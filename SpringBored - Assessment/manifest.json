{
  "manifest_version": 3,
  "name": "SpringBored (Assessment Edition)",
  "version": "1.0.0",
  "description": "Autonomous Infosys Springboard quiz and multi-section assessment solver powered by Google Gemini AI.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://*.onwingspan.com/*",
    "https://*.springboard.infosys.com/*",
    "https://*.infosys.com/*",
    "https://*.infosysapps.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.onwingspan.com/*",
        "https://*.springboard.infosys.com/*",
        "https://*.infosys.com/*",
        "https://*.infosysapps.com/*"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "Assets/Logo.png",
        "icons/icon16.png",
        "icons/icon48.png",
        "icons/icon128.png"
      ],
      "matches": [
        "https://*.onwingspan.com/*",
        "https://*.springboard.infosys.com/*",
        "https://*.infosys.com/*",
        "https://*.infosysapps.com/*"
      ]
    }
  ]
}
