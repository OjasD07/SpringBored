{
  "manifest_version": 3,
  "name": "SpringBored (Assignment Edition)",
  "version": "2.2.1",
  "description": "Autonomous Infosys Springboard quiz and multi-section assessment solver powered by Gemini 3.8 Flash.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://*.onwingspan.com/*",
    "https://*.springboard.infosys.com/*",
    "https://*.infosys.com/*",
    "https://*.infosysapps.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.onwingspan.com/*",
        "https://*.springboard.infosys.com/*",
        "https://*.infosys.com/*",
        "https://*.infosysapps.com/*",
        "https://*/*"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
